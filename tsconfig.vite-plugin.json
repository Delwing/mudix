{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2022"],
    "types": ["node"],
    "strict": true,
    "skipLibCheck": true,
    "declaration": true,
    "outDir": "dist-lib",
    "rootDir": "vite-plugin"
  },
  "include": ["vite-plugin/**/*"]
}
